# PostgreSQL. Локально: createdb shop && createdb shop_test
# На проде — URL базы из Coolify (postgresql-database-shop), задаётся в переменных окружения Coolify
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop"
# Отдельная база для e2e-тестов (npm run test:e2e очищает её перед запуском)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop_test"
PORT=4500
CLIENT_URL="http://localhost:3003"
# Под каким путём браузер видит API (прокси Next /api/* → сервер). По умолчанию /api
# PUBLIC_API_PREFIX="/api"
# openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Главный администратор: создаётся сидом (npm run db:seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Пароль демо-аккаунтов demo@ / picker@ / courier@example.com. Только локально: на проде не задавать
DEMO_PASSWORD=""
