# Скопируйте в .env и при необходимости поменяйте значения (.env не в git)

# Адрес NestJS-сервера для браузера.
# /api — через прокси Next (тот же адрес, что у сайта; можно показать сайт через туннель с одним портом).
# Ходить на сервер напрямую, без прокси: NEXT_PUBLIC_API_URL=http://localhost:4500
NEXT_PUBLIC_API_URL=/api

# Куда Next проксирует /api/* (используется в next.config.ts, в браузер не попадает)
API_PROXY_TARGET=http://localhost:4500
